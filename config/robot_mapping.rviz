Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: RTAB-Map geometry
      Enabled: true
      Topic:
        Value: /rtabmap_yolo/cloud_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: YOLO semantic map
      Enabled: true
      Topic:
        Value: /semantic/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 4
    - Class: rviz_default_plugins/Map
      Name: RTAB-Map occupancy
      Enabled: true
      Topic:
        Value: /rtabmap_yolo/map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: YOLO image
      Enabled: true
      Topic:
        Value: /semantic/image_annotated
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Pitch: 0.6
      Yaw: 0.8
